# deploy/spark/.env.example -> cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 모델·서빙 값은 trainer/configs/rag_config_spark_vllm.yaml과 같아야 한다(trainer/scripts/tests/test_spark_deploy_contract.py).

# --- 번들·결과 경로 (Spark 호스트) ---
BUNDLE_DIR=/srv/shipcoat/bundle/spark-v6.1-fp8
RESULTS_DIR=/srv/shipcoat/results
# Offline multilingual STT model. The image never downloads this at runtime.
STT_MODEL_DIR=/home/keti/shipcoat/models/whisper-large-v3-turbo
# 학습모드 FBX 원본. 없어도 서버는 기동하며 모션 뷰어는 Ray Point 형상으로 대체한다.
POSE_MODELINGS_DIR=/home/keti/shipcoat/data/modelings
# agent-api·mcp 실행 UID/GID. RESULTS_DIR 소유자와 맞춘다(예: id -u).
APP_UID=10001
APP_GID=10001

# --- 이미지 ---
# 코드 커밋(이미지 라벨·SHIPCOAT_CODE_COMMIT). 빌드할 때 git rev-parse HEAD.
CODE_COMMIT=
# 1순위 vllm/vllm-openai:v0.29.0 (arm64 multi-arch), 대안 nvcr.io/nvidia/vllm:26.08-py3.
# digest 고정: VLLM_IMAGE=vllm/vllm-openai:v0.29.0@sha256:<digest> (README §2)
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
AGENT_API_IMAGE=shipcoat/agent-api:v6.1
MCP_IMAGE=shipcoat/mcp:v6.1
WEB_IMAGE=shipcoat/web:v6.1

# --- vLLM ---
# 번들 output/merged/ 아래 디렉터리. 롤백: qwen36_27b_shipcoat_v6_1_bf16 (README §18)
MODEL_SUBDIR=qwen36_27b_shipcoat_v6_1_fp8
# = llm.served_model_name
SERVED_MODEL_NAME=qwen36-27b-shipcoat-v6-1-fp8
# = llm.max_model_len
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=4
GPU_MEMORY_UTILIZATION=0.72
# 체크포인트 generation_config(temperature 1.0 / top_p 0.95)를 기본값으로 쓰지 않는다.
GENERATION_CONFIG=vllm
# 이중 방어: 요청마다 샘플링을 명시하지만(D6) 빠진 요청이 있어도 설정값으로 떨어지게 한다. = generation.*
OVERRIDE_GENERATION_CONFIG='{"temperature":0.3,"top_p":0.8,"top_k":20,"repetition_penalty":1.15}'
# MTP는 README §15 수락률·소크 합격 후 1로 올린다.
ENABLE_MTP=0
MTP_NUM_SPECULATIVE_TOKENS=1
# 텍스트 전용. MTP와 동시 사용 가능 여부는 미확인(README §6 확인 항목).
LANGUAGE_MODEL_ONLY=0
# 추가 인자(공백 구분). --enable-auto-tool-choice / --tool-call-parser / --reasoning-parser 는 거부된다.
VLLM_EXTRA_ARGS=
# vLLM 인증 토큰. agent-api는 같은 변수(llm.api_key_env)로 Bearer 헤더를 붙인다.
VLLM_API_KEY=
VLLM_BIND=127.0.0.1
VLLM_HOST_PORT=18000

# --- agent-api ---
# 롤백 시 /bundle-config/rag_config_spark_vllm_bf16.yaml
AGENT_CONFIG_PATH=/workspace/trainer/configs/rag_config_spark_vllm.yaml
# KETI 시뮬레이터용 copilot/query 노출. 외부 공개는 COPILOT_BIND=0.0.0.0
COPILOT_BIND=127.0.0.1
COPILOT_PORT=58000
DEMO_UI_ORIGINS=
STT_DEVICE=cuda

# --- web ---
WEB_BIND=0.0.0.0
WEB_PORT=8080
