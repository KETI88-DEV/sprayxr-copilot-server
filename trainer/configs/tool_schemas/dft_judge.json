{
  "type": "function",
  "function": {
    "name": "dft_judge",
    "description": "건조도막두께 측정값과 목표 두께로 도막 등급을 판정한다. 칠한 곳 평균이 목표 미만이면 저도막, 목표의 1.5배 이상이면 과도막, 그 사이는 정상이다. 목표가 없으면 기본 목표 160μm로 판정한다.",
    "parameters": {
      "type": "object",
      "properties": {
        "measurements": {
          "type": "array",
          "items": {"type": "number"},
          "description": "DFT 측정값 배열 (단위: um)"
        },
        "spec": {
          "type": "object",
          "properties": {
            "nominal": {
              "type": "number",
              "description": "목표 두께(μm). 없으면 기본 160"
            },
            "tolerance_rule": {
              "type": "string",
              "enum": ["90/10"],
              "description": "예전 호출 호환용. 판정에 쓰지 않는다"
            }
          }
        }
      },
      "required": ["measurements"]
    }
  }
}
