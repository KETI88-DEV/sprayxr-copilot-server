{
  "type": "function",
  "function": {
    "name": "anomaly_detection",
    "description": "히트맵 이미지 분석 context와 DFT 측정값, 환경 조건을 입력받아 도막 이상 상태(저도막/과도막/결함)를 탐지한다. Qwen VL이 이미지를 앞단에서 분석한 image_context를 입력으로 받는다.",
    "parameters": {
      "type": "object",
      "properties": {
        "image_context": {
          "type": "string",
          "description": "VL 모델이 히트맵 이미지를 분석하여 생성한 텍스트 context (예: '좌하단 B-3-L 구역 청색 집중, 전체 대비 저도막 패턴')"
        },
        "dft_measurements": {
          "type": "array",
          "items": {"type": "number"},
          "description": "DFT 측정값 배열 (단위: um)"
        },
        "env": {
          "type": "object",
          "properties": {
            "temperature": {
              "type": "number",
              "description": "온도 (C)"
            },
            "humidity": {
              "type": "number",
              "description": "습도 (%)"
            }
          },
          "required": ["temperature", "humidity"]
        }
      },
      "required": ["image_context", "dft_measurements", "env"]
    }
  }
}
