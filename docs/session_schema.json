{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ship-paint-copilot/schemas/session_schema.json",
  "title": "Ship Painting Training Session",
  "description": "XR 도장 훈련 시뮬레이터(Unity)가 출력하는 세션 단위 원본 데이터 스키마. 파일 경로 규칙: sessions/{level_id}/{worker_id}/{session_id}.json (세션 1개 = 파일 1개). 필드명은 mcp_servers/의 Pydantic 모델(pose_estimation.Joint, sequence_validation.ZoneInfo, anomaly_detection.TimeseriesData/DftPoint, dft_judge.DFTSpec)과 1:1로 일치하며, RAG/순서/자세 모델 학습 데이터는 이 스키마에서 파생한다.",
  "type": "object",
  "required": ["schema_version", "session_id", "level", "worker", "spec", "strokes", "result"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "스키마 버전 (semver). 파서 호환성 판단용.",
      "pattern": "^\\d+\\.\\d+$",
      "examples": ["1.0"]
    },
    "session_id": {
      "type": "string",
      "description": "세션 고유 ID. timeseries MCP의 session_id로 그대로 사용.",
      "pattern": "^S-[0-9]{8}-[0-9]{3,}$",
      "examples": ["S-20260721-001"]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "세션 시작 시각 (ISO 8601)."
    },
    "level": { "$ref": "#/$defs/Level" },
    "worker": { "$ref": "#/$defs/Worker" },
    "spec": { "$ref": "#/$defs/DFTSpec" },
    "strokes": {
      "type": "array",
      "description": "스트로크(1회 분사 동작) 시퀀스. stroke_index 오름차순 정렬 필수 — 배열 순서 자체가 순서 모델의 정답 시퀀스.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Stroke" }
    },
    "result": { "$ref": "#/$defs/SessionResult" }
  },
  "$defs": {
    "Level": {
      "type": "object",
      "description": "도장 대상 레벨(3D mesh) 메타데이터.",
      "required": ["level_id", "mesh_ref", "structure_type", "zone_map"],
      "additionalProperties": false,
      "properties": {
        "level_id": {
          "type": "string",
          "pattern": "^LV-[0-9]{2,}$",
          "examples": ["LV-03"]
        },
        "mesh_ref": {
          "type": "string",
          "description": "3D mesh 파일 상대 경로 (glb/fbx 등). 바이너리를 JSON에 임베드하지 않고 참조만 한다.",
          "examples": ["meshes/LV-03.glb"]
        },
        "structure_type": {
          "type": "string",
          "description": "sequence_validation.SequenceValidationRequest.structure_type과 동일 enum.",
          "enum": ["block", "hull_section", "deck", "superstructure"]
        },
        "zone_map": {
          "type": "array",
          "description": "구역 목록. sequence_validation.ZoneInfo와 필드 1:1 (is_painted는 세션 시작 시점 상태).",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ZoneInfo" }
        }
      }
    },
    "ZoneInfo": {
      "type": "object",
      "required": ["zone_id", "block_id", "zone_type", "position"],
      "additionalProperties": false,
      "properties": {
        "zone_id": {
          "type": "string",
          "examples": ["Z-A-01"]
        },
        "block_id": {
          "type": "string",
          "examples": ["BLK-A"]
        },
        "zone_type": {
          "type": "string",
          "description": "sequence_validation.ZoneInfo.zone_type과 동일 enum (한국어 리터럴).",
          "enum": ["수직 패널", "수평 패널", "곡면", "모서리"]
        },
        "position": {
          "type": "string",
          "description": "sequence_validation.ZoneInfo.position과 동일 enum.",
          "enum": ["upper", "middle", "lower", "left", "right", "center"]
        },
        "is_painted": {
          "type": "boolean",
          "default": false,
          "description": "세션 시작 시점에 이미 도장 완료된 구역 여부."
        },
        "area_m2": {
          "type": "number",
          "minimum": 0,
          "default": 0.0
        },
        "face_ids": {
          "type": "array",
          "description": "이 구역에 속하는 mesh 삼각형/패치 ID 목록. strokes[].contact.face_ids와 조인하여 접촉면→구역 매핑에 사용.",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        }
      }
    },
    "Worker": {
      "type": "object",
      "required": ["worker_id", "skill_level"],
      "additionalProperties": false,
      "properties": {
        "worker_id": {
          "type": "string",
          "pattern": "^W-[0-9]{3,}$",
          "examples": ["W-017"]
        },
        "skill_level": {
          "type": "string",
          "description": "자세/순서 모델 학습 라벨의 근거. expert 세션의 pose_frames·방문 순서가 정답 데이터가 된다.",
          "enum": ["expert", "intermediate", "novice"]
        },
        "handedness": {
          "type": "string",
          "enum": ["right", "left"],
          "default": "right"
        }
      }
    },
    "DFTSpec": {
      "type": "object",
      "description": "dft_judge.DFTSpec / anomaly_detection.Spec과 동일. nominal_um은 양수.",
      "required": ["nominal_um", "tolerance_rule"],
      "additionalProperties": false,
      "properties": {
        "nominal_um": {
          "type": "number",
          "exclusiveMinimum": 0,
          "examples": [100.0]
        },
        "tolerance_rule": {
          "type": "string",
          "const": "90/10",
          "description": "SSPC-PA2 90/10 규칙. 현재 dft_judge가 지원하는 유일한 규칙."
        }
      }
    },
    "Stroke": {
      "type": "object",
      "description": "한 스트로크(1회 분사 동작)의 자세·궤적·접촉면·도구 파라미터.",
      "required": ["stroke_id", "stroke_index", "zone_id", "t_start", "t_end", "pose_frames", "tool_track", "contact", "tool_params"],
      "additionalProperties": false,
      "properties": {
        "stroke_id": {
          "type": "string",
          "pattern": "^ST-[0-9]{4,}$",
          "examples": ["ST-0001"]
        },
        "stroke_index": {
          "type": "integer",
          "minimum": 1,
          "description": "세션 내 실행 순서 (1부터). strokes 배열은 이 값의 오름차순이어야 한다."
        },
        "zone_id": {
          "type": "string",
          "description": "level.zone_map[].zone_id 중 하나여야 한다 (참조 무결성은 검증 스크립트에서 확인)."
        },
        "t_start": {
          "type": "number",
          "minimum": 0,
          "description": "세션 시작 기준 상대 초."
        },
        "t_end": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "세션 시작 기준 상대 초. t_start보다 커야 한다 (검증 스크립트에서 확인)."
        },
        "pose_frames": {
          "type": "array",
          "description": "작업자 자세 프레임 (권장 10~30Hz). 자세 모델 학습 데이터. 프레임률이 높아 파일이 커지면 별도 JSONL로 분리하고 pose_frames_ref로 대체 가능.",
          "items": { "$ref": "#/$defs/PoseFrame" }
        },
        "pose_frames_ref": {
          "type": "string",
          "description": "pose_frames를 외부 JSONL로 분리한 경우의 상대 경로. 사용 시 pose_frames는 빈 배열."
        },
        "tool_track": { "$ref": "#/$defs/ToolTrack" },
        "contact": { "$ref": "#/$defs/Contact" },
        "tool_params": { "$ref": "#/$defs/ToolParams" }
      }
    },
    "PoseFrame": {
      "type": "object",
      "required": ["t", "joints"],
      "additionalProperties": false,
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "세션 시작 기준 상대 초."
        },
        "joints": {
          "type": "object",
          "description": "관절명 → Joint 매핑. pose_estimation.Pose.joints(dict[str, Joint])와 동일 구조. 표준 6관절(wrist_r/l, elbow_r/l, shoulder_r/l)을 권장하되 추가 관절 허용.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/Joint" }
        }
      }
    },
    "Joint": {
      "type": "object",
      "description": "pose_estimation.Joint와 필드 1:1. 위치는 미터, 각도는 도(deg).",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "roll": { "type": ["number", "null"], "default": null },
        "pitch": { "type": ["number", "null"], "default": null },
        "yaw": { "type": ["number", "null"], "default": null }
      }
    },
    "ToolTrack": {
      "type": "object",
      "description": "도구(스프레이 건) 움직임 시계열. anomaly_detection.TimeseriesData와 필드명 1:1. 모든 배열은 timestamps와 길이가 같아야 한다 (검증 스크립트에서 확인).",
      "required": ["timestamps", "trajectory", "gun_speed_m_per_s", "standoff_distance_mm", "spray_angle_deg"],
      "additionalProperties": false,
      "properties": {
        "timestamps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "trajectory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TrajectoryPoint" }
        },
        "gun_speed_m_per_s": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "standoff_distance_mm": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "spray_angle_deg": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0, "maximum": 180 }
        }
      }
    },
    "TrajectoryPoint": {
      "type": "object",
      "description": "anomaly_detection.TrajectoryPoint와 동일. 레벨 좌표계 기준 미터.",
      "required": ["x", "y", "z"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "Contact": {
      "type": "object",
      "description": "스트로크가 도장 대상 mesh에 실제 접촉(도포)한 면 정보.",
      "required": ["face_ids", "coverage_ratio"],
      "additionalProperties": false,
      "properties": {
        "face_ids": {
          "type": "array",
          "description": "도료가 도포된 mesh 삼각형/패치 ID. level.zone_map[].face_ids와 조인.",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "이 스트로크가 해당 zone 면적을 덮은 비율."
        },
        "overlap_ratio_prev": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "직전 스트로크와의 겹침 비율. 50% overlap 규칙 평가용. 첫 스트로크는 생략."
        }
      }
    },
    "ToolParams": {
      "type": "object",
      "description": "스트로크 시작 시점의 도구 설정 스냅샷.",
      "required": ["spray_pressure_bar", "nozzle_tip", "paint_type"],
      "additionalProperties": false,
      "properties": {
        "spray_pressure_bar": {
          "type": "number",
          "exclusiveMinimum": 0,
          "examples": [3.2]
        },
        "nozzle_tip": {
          "type": "string",
          "examples": ["517"]
        },
        "flow_rate_ml_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "examples": [850]
        },
        "paint_type": {
          "type": "string",
          "examples": ["epoxy_primer"]
        }
      }
    },
    "SessionResult": {
      "type": "object",
      "description": "세션 종료 시점의 도장 결과 분포.",
      "required": ["dft_measurements"],
      "additionalProperties": false,
      "properties": {
        "dft_measurements": {
          "type": "array",
          "description": "건조도막두께 측정점 목록. anomaly_detection.DftPoint와 필드 1:1. value_um만 뽑으면 dft_judge.measurements가 된다.",
          "minItems": 1,
          "items": { "$ref": "#/$defs/DftPoint" }
        },
        "dft_map_ref": {
          "type": "string",
          "description": "버텍스/픽셀 단위 두께맵 파일 상대 경로 (exr/png 등). 대용량 바이너리는 참조만 한다.",
          "examples": ["results/S-20260721-001_dft.exr"]
        },
        "defects": {
          "type": "array",
          "description": "결함 목록. type은 anomaly_detection의 분류(저도막/과도막)에 흘림/오렌지필 등 육안 결함을 추가한 enum.",
          "items": { "$ref": "#/$defs/Defect" }
        }
      }
    },
    "DftPoint": {
      "type": "object",
      "required": ["value_um"],
      "additionalProperties": false,
      "properties": {
        "value_um": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "zone_id": {
          "type": "string",
          "default": ""
        },
        "position": {
          "type": "string",
          "description": "구역 내 측정 위치. anomaly_detection의 분포 분석(_analyze_distribution)이 사용하는 값.",
          "enum": ["upper", "middle", "lower", "left", "right", "center", ""]
        }
      }
    },
    "Defect": {
      "type": "object",
      "required": ["zone_id", "type", "severity"],
      "additionalProperties": false,
      "properties": {
        "zone_id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["저도막", "과도막", "흘림", "오렌지필", "핀홀", "미도장"]
        },
        "position": {
          "type": "string",
          "enum": ["upper", "middle", "lower", "left", "right", "center"]
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "결함 심각도 (0=경미, 1=심각)."
        }
      }
    }
  }
}
