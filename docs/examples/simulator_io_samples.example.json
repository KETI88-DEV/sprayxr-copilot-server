      "wrist_r":    {"x": 0.10, "y": -0.04, "z": 0.44, "roll": 2.0,  "pitch": 12.0, "yaw": 5.0},
      "wrist_l":    {"x": -0.10,"y": -0.04, "z": 0.44, "roll": 2.0,  "pitch": 12.0, "yaw": 5.0},
      "elbow_r":    {"x": 0.25, "y": -0.10, "z": 0.35, "roll": 0.0,  "pitch": 8.0,  "yaw": 0.0},
      "elbow_l":    {"x": -0.25,"y": -0.10, "z": 0.35, "roll": 0.0,  "pitch": 8.0,  "yaw": 0.0},
      "shoulder_r": {"x": 0.35, "y":  0.00, "z": 0.20, "roll": 0.0,  "pitch": 5.0,  "yaw": 0.0},
      "shoulder_l": {"x": -0.35,"y":  0.00, "z": 0.20, "roll": 0.0,  "pitch": 5.0,  "yaw": 0.0}
    },
    "$notes": [
      "mode: compare | recommend",
      "compare: current_pose 필수. block_id 또는 expert_pose_id로 기준 자세 선택",
      "recommend: block_id 필수. 해당 블록의 권장 숙련자 자세 ID를 반환",
      "similarity_score: 0.0~1.0. 1.0이 완전 일치",
      "angle_corrections의 값이 양수면 '과다', 음수면 '부족'",
      "교정 임계값: 각도 차이 3° 초과 시 corrections에 포함",
      "현재 지원 관절: wrist_r/l, elbow_r/l, shoulder_r/l (6개)",
      "MCP는 컨테이너 내부(:8100)에서만 접근 가능. 외부에서는 /api/chat live 경로를 통해 간접 호출됨"
    ]
  },

  "12_mcp_pose_recommend": {
    "$endpoint": "POST /pose_estimation/compare  (MCP :8100)",
    "$purpose": "블록 ID로 권장 숙련자 자세 ID를 조회한다. 훈련 시작 전 기준 자세 확인용.",
    "request": {
      "mode": "recommend",
      "block_id": "BLK-A"
