  "13_mcp_location_identify": {
    "$endpoint": "POST /location_tracking/identify  (MCP :8100, 컨테이너 내부 전용)",
    "$purpose": "3D 좌표 목록으로 현재 구역 ID와 커버리지를 반환한다. 시뮬레이터 runtime 이벤트에 zone_id가 없을 때 폴백으로 호출된다.",
    "request": {
      "coordinates": [
        {"x": 1.2, "y": 3.5, "z": 0.8, "timestamp": 1753750000.0},
        {"x": 1.3, "y": 3.6, "z": 0.9, "timestamp": 1753750001.0}
      ],
      "ship_model_id": "TR-L01"
    },
    "response_200": {
      "status": "success",
      "result": {
