            "label": "오른쪽 팔꿈치",
            "distance": 0.0412,
            "angle_corrections": {"pitch": 10.0, "yaw": 5.0},
            "correction_text": "오른쪽 팔꿈치: pitch 10° 과다, yaw 5° 과다"
          },
          {
            "joint": "wrist_r",
            "label": "오른쪽 손목",
            "distance": 0.0574,
            "angle_corrections": {"roll": 6.0, "pitch": 13.0, "yaw": 7.0},
            "correction_text": "오른쪽 손목: roll 6° 과다, pitch 13° 과다, yaw 7° 과다"
          },
          {
            "joint": "elbow_l",
            "label": "왼쪽 팔꿈치",
            "distance": 0.0173,
            "angle_corrections": {},
