  "14_runtime_full_telemetry": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "gun_metrics + pose_joints + coordinates를 모두 포함한 최대 페이로드 예시.",
    "request": {
      "event_id": "ev-5",
      "zone_id": "A-3",
      "telemetry": {
        "gun_metrics": {
          "speed_m_per_s": 0.75,
          "standoff_mm": 310.0,
          "angle_deg": 68.0
        },
        "pose_joints": {
          "wrist_r":    0.15,
          "wrist_l":    -0.12,
          "elbow_r":    0.28,
          "elbow_l":    -0.26,
          "shoulder_r": 0.36,
          "shoulder_l": -0.35
        },
        "coordinates": [1.2, 3.5, 0.8]
      }
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "event_id": "ev-5",
      "kind": "ack",
      "message": "이벤트 누적됨.",
      "anomaly": null
    },
    "$notes": [
      "zone_id가 있으므로 coordinates는 위치 해석에 사용되지 않는다 (zone_id 우선)",
      "pose_joints는 기록만 됨. 자세 비교는 MCP pose_estimation/compare를 별도 호출",
      "gun_metrics가 정상 범위(standoff ≤ 320, angle ≥ 60)이므로 kind:ack 반환"
    ]
  },

  "10_error_422": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "422 오류 예시. 필수 필드 누락 또는 알 수 없는 필드.",
    "request_missing_required": {
      "zone_id": "A-2"
    },
    "response_422_missing": {
      "error": "validation_error",
      "detail": [
        {
          "type": "missing",
          "loc": ["event_id"],
          "msg": "Field required",
          "input": {"zone_id": "A-2"}
        }
      ]
    },
    "request_extra_field": {
      "event_id": "ev-9",
      "oops": 1
    },
    "response_422_extra": {
      "error": "validation_error",
      "detail": [
        {
          "type": "extra_forbidden",
          "loc": ["oops"],
          "msg": "Extra inputs are not permitted",
          "input": 1
        }
      ]
    },
    "response_422_mismatch": {
      "error": "session_id_mismatch",
      "path": "TR-L01-20260729-001",
      "body": "other-session"
    },
    "$notes": [
      "422는 세션 상태를 전혀 바꾸지 않는다",
      "422도 모니터에 input/output 두 건이 기록된다 (관측 가능)",
      "start/runtime은 extra='forbid' — 스키마 외 필드 불허",
      "complete(SessionSummary)는 현재 느슨함 — 추가 필드 허용"
    ]
  }
