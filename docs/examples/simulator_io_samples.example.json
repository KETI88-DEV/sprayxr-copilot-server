{
  "$comment": "시뮬레이터 인터페이스 I/O 샘플. 각 top-level 키는 별개의 HTTP 요청/응답 쌍이다. 실제 API(http://127.0.0.1:8120)로 검증한 값이며 2026-07-29 기준이다. 계약 정본: trainer/demo_api/sim_contracts.py (Pydantic) ↔ demo-ui/src/simContracts.ts (Zod).",

  "1_session_start": {
    "$endpoint": "POST /api/sim/sessions/start",
    "$purpose": "세션 컨텍스트 초기화. 응답의 recommended_flow가 도장 순서 패널과 모델 environment의 소유자가 된다.",
    "request": {
      "session_id": "TR-L01-20260729-001",
      "level_id": "TR-L01",
      "worker": {
        "trainee_id": "t-001",
        "skill_level": "beginner",
        "handedness": "right"
      },
      "spec": {
        "nominal_um": 100.0
      }
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "recommended_flow": ["A-1", "A-2", "A-3"],
      "flow_source": "rule",
      "guidance": "레벨 TR-L01 권장 도장 순서: A-1 → A-2 → A-3. 상부에서 하부 순으로 진행하십시오."
    },
    "$notes": [
      "skill_level: beginner | intermediate | advanced",
      "handedness: left | right",
      "session_id는 경로 파라미터와 일치해야 한다 (start는 경로 없음, 본문만)",
      "새 start는 이전 세션을 덮어쓴다 (단일 슬롯)"
    ]
  },

  "2_runtime_normal": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "정상 범위 텔레메트리. zone_id로 현재 위치를 A-2로 이동시킨다.",
    "request": {
      "event_id": "ev-0",
      "zone_id": "A-2",
      "telemetry": {
        "gun_metrics": {
          "speed_m_per_s": 0.8,
          "standoff_mm": 300.0,
          "angle_deg": 72.0
        }
      }
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "event_id": "ev-0",
      "kind": "ack",
      "message": "이벤트 누적됨.",
      "anomaly": null
    },
    "$notes": [
      "event_id만 필수. 나머지(zone_id, telemetry, user_request)는 선택",
      "zone_id가 있으면 현재 위치를 해당 구역으로 이동",
      "정상 범위: standoff_mm ≤ 320, angle_deg ≥ 60"
    ]
  },

  "3_runtime_anomaly": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "이상 파라미터 텔레메트리. standoff 초과 + angle 미달로 anomaly 응답.",
    "request": {
      "event_id": "ev-1",
      "telemetry": {
        "gun_metrics": {
          "speed_m_per_s": 0.8,
          "standoff_mm": 350.0,
          "angle_deg": 55.0
        }
      }
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "event_id": "ev-1",
      "kind": "anomaly",
      "message": "스프레이 파라미터 이탈 감지(스텁).",
      "anomaly": {
        "type": "spray_param_out_of_band",
        "standoff_mm": 350.0,
        "angle_deg": 55.0,
        "severity": "high"
      }
    },
    "$notes": [
      "standoff_mm > 320 OR angle_deg < 60 → kind: anomaly",
      "둘 다 이탈이면 severity: high, 하나만이면 medium",
      "zone_id 없이 telemetry만 보내면 위치는 이동하지 않는다"
    ]
  },

  "4_runtime_user_request": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "작업자 음성/텍스트 질의. user_request가 있으면 kind:rag 응답 (자세 판정보다 우선).",
    "request": {
      "event_id": "ev-2",
      "user_request": "현재 도막 두께가 기준에 맞나요?"
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "event_id": "ev-2",
      "kind": "rag",
      "message": "질의 응답(스텁): '현재 도막 두께가 기준에 맞나요?' 관련 문서 근거를 확인하세요.",
      "anomaly": null
    },
    "$notes": [
      "user_request가 있으면 telemetry보다 우선해 kind:rag 반환",
      "현재 응답은 결정론 스텁. 실제 AgentPipeline 연결 시 RAG 응답으로 대체됨"
    ]
  },

  "5_runtime_coordinates": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "zone_id 없이 좌표만 보내는 경우. location_tracking MCP로 구역 해석 시도.",
    "request": {
      "event_id": "ev-3",
      "telemetry": {
        "gun_metrics": {
          "speed_m_per_s": 0.8,
          "standoff_mm": 300.0,
          "angle_deg": 72.0
        },
        "coordinates": [1.2, 3.5, 0.8]
      }
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "event_id": "ev-3",
      "kind": "ack",
      "message": "이벤트 누적됨.",
      "anomaly": null
    },
    "$notes": [
      "zone_id가 없고 coordinates가 있으면 MCP location_tracking/identify로 구역 해석",
      "현재 location_tracking은 stub — 항상 B-3 반환. B-3는 TR-L01 구역 맵에 없으므로",
      "위치는 이동하지 않고 unresolved_zone_id: B-3 로만 기록됨",
      "coordinates 형식: [x, y, z] (미터 단위 권장)"
    ]
  },

  "6_session_complete": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/complete",
    "$purpose": "세션 종료 및 위험 플래그 리뷰. 측정 지표를 전송하면 자동으로 플래그를 계산한다.",
    "request": {
      "session_id": "TR-L01-20260729-001",
      "scenario_id": "demo",
      "mode": "live",
      "zone_id": "A-2",
      "zone_type": "panel",
      "metrics": {
        "avg_dft": 92.0,
        "dft_values": [95.0, 102.0, 88.0],
        "avg_speed": 0.8,
        "speed_variance": 0.05,
        "avg_distance": 0.3,
        "distance_variance": 0.05,
        "avg_angle": 70.0,
        "angle_consistency": 0.9,
        "sequence_correct": true,
        "under_thickness_count": 1
      }
    },
    "response_200": {
      "session_id": "TR-L01-20260729-001",
      "summary": "세션 TR-L01-20260729-001 리뷰: 위험 플래그 1건 감지.",
      "risk_flags": [
        {
          "flag": "under_thickness",
          "severity": "low",
          "value": 1,
          "threshold": 0
        }
      ],
      "action_items": [
        {
          "action": "under_thickness 개선 필요",
          "priority": "low"
        }
      ],
      "citations": []
    },
    "$risk_flag_thresholds": {
      "under_thickness_count > 0": "under_thickness (low/medium/high: 1/2/3+건)",
      "over_thickness_count > 0": "over_thickness (low/medium/high: 1/2/3+건)",
      "distance_variance > 0.3": "distance_variance (low/medium/high: >0.3/>0.45/>0.6)",
      "speed_variance > 0.15": "speed_variance (low/medium/high: >0.15/>0.22/>0.3)",
      "angle_consistency < 0.7": "angle_consistency_low (low/medium/high: <0.7/<0.55/<0.4)",
      "sequence_correct = false": "sequence_violation (항상 high)"
    },
    "$notes": [
      "under_thickness_count, over_thickness_count 기본값 0 (선택 필드)",
      "env, timestamp 선택 필드",
      "session_id는 경로 파라미터와 일치해야 한다"
    ]
  },

  "7_session_state": {
    "$endpoint": "GET /api/sim/session",
    "$purpose": "현재 세션 상태 조회 (read-only). 도장 순서 패널과 모델 environment가 이 값을 읽는다.",
    "response_200_active": {
      "session": {
        "session_id": "TR-L01-20260729-001",
        "level_id": "TR-L01",
        "phase": "session_end",
        "recommended_flow": ["A-1", "A-2", "A-3"],
        "current_zone_id": "A-2",
        "completed_zone_ids": ["A-1"],
        "last_event_id": "ev-2",
        "anomaly_count": 1,
        "unresolved_zone_id": null,
        "updated_at": "2026-07-29T02:21:58.043166+00:00"
      }
    },
    "response_200_no_session": {
      "session": null
    },
    "$notes": [
      "phase: start | runtime | session_end",
      "세션이 없으면 session: null",
      "unresolved_zone_id: 권장 순서 밖 구역이 감지된 경우 해당 zone_id, 없으면 null"
    ]
  },

  "8_monitor_snapshot": {
    "$endpoint": "GET /api/monitor/events?cursor=0&limit=20",
    "$purpose": "모니터 링버퍼 스냅샷. 모든 요청의 input/output이 기록된다 (422 포함).",
    "response_200": {
      "events": [
        {
          "seq": 1,
          "session_id": "TR-L01-20260729-001",
          "phase": "start",
          "direction": "input",
          "timestamp": "2026-07-29T02:21:57.000000+00:00",
          "payload": {
            "session_id": "TR-L01-20260729-001",
            "level_id": "TR-L01",
            "worker": {"trainee_id": "t-001", "skill_level": "beginner", "handedness": "right"},
            "spec": {"nominal_um": 100.0}
          }
        },
        {
          "seq": 2,
          "session_id": "TR-L01-20260729-001",
          "phase": "start",
          "direction": "output",
          "timestamp": "2026-07-29T02:21:57.001000+00:00",
          "payload": {
            "session_id": "TR-L01-20260729-001",
            "recommended_flow": ["A-1", "A-2", "A-3"],
            "flow_source": "rule",
            "guidance": "레벨 TR-L01 권장 도장 순서: A-1 → A-2 → A-3. 상부에서 하부 순으로 진행하십시오."
          }
        },
        {
          "seq": 3,
          "session_id": "TR-L01-20260729-001",
          "phase": "runtime",
          "direction": "input",
          "timestamp": "2026-07-29T02:21:57.100000+00:00",
          "payload": {
            "event_id": "ev-0",
            "zone_id": "A-2",
            "telemetry": {"gun_metrics": {"speed_m_per_s": 0.8, "standoff_mm": 300.0, "angle_deg": 72.0}}
          }
        },
        {
          "seq": 4,
          "session_id": "TR-L01-20260729-001",
          "phase": "runtime",
          "direction": "output",
          "timestamp": "2026-07-29T02:21:57.101000+00:00",
          "payload": {
            "session_id": "TR-L01-20260729-001",
            "event_id": "ev-0",
            "kind": "ack",
            "message": "이벤트 누적됨.",
            "anomaly": null
          }
        }
      ],
      "next_cursor": 4,
      "dropped_before": null
    },
    "$notes": [
      "cursor: 이 seq 이후 이벤트만 반환. 0이면 전체",
      "next_cursor: 다음 조회 시 cursor로 사용",
      "dropped_before: 링버퍼(500건) 초과로 유실된 이벤트가 있으면 첫 seq 번호",
      "direction: input(요청) | output(응답). 422도 두 건 모두 기록됨"
    ]
  },

  "9_monitor_stream": {
    "$endpoint": "GET /api/monitor/stream?cursor=0",
    "$purpose": "SSE 스트림. cursor 이후 이벤트를 리플레이한 뒤 실시간 이벤트를 전달한다.",
    "sse_frames": [
      "event: monitor\ndata: {\"seq\":1,\"session_id\":\"TR-L01-20260729-001\",\"phase\":\"start\",\"direction\":\"input\",\"timestamp\":\"2026-07-29T02:21:57.000000+00:00\",\"payload\":{...}}\n\n",
      "event: monitor\ndata: {\"seq\":2,...}\n\n",
      "event: gap\ndata: {\"dropped_before\":501}\n\n"
    ],
    "$notes": [
      "event: monitor — 정상 이벤트",
      "event: gap — 링버퍼 초과로 유실 구간 발생 시 첫 프레임으로 전송",
      "연결이 끊기면 스스로 복구하지 않는다. 클라이언트가 재연결해야 한다",
      "재연결 시 cursor=last_seq로 보내면 유실 없이 이어받을 수 있다"
    ]
  },

  "10_error_422": {
    "$endpoint": "POST /api/sim/sessions/{session_id}/events",
    "$purpose": "422 오류 예시. 필수 필드 누락 또는 알 수 없는 필드.",
    "request_missing_required": {
      "zone_id": "A-2"
    },
    "response_422_missing": {
      "error": "validation_error",
      "detail": [
        {
          "type": "missing",
          "loc": ["event_id"],
          "msg": "Field required",
          "input": {"zone_id": "A-2"}
        }
      ]
    },
    "request_extra_field": {
      "event_id": "ev-9",
      "oops": 1
    },
    "response_422_extra": {
      "error": "validation_error",
      "detail": [
        {
          "type": "extra_forbidden",
          "loc": ["oops"],
          "msg": "Extra inputs are not permitted",
          "input": 1
        }
      ]
    },
    "response_422_mismatch": {
      "error": "session_id_mismatch",
      "path": "TR-L01-20260729-001",
      "body": "other-session"
    },
    "$notes": [
      "422는 세션 상태를 전혀 바꾸지 않는다",
      "422도 모니터에 input/output 두 건이 기록된다 (관측 가능)",
      "start/runtime은 extra='forbid' — 스키마 외 필드 불허",
      "complete(SessionSummary)는 현재 느슨함 — 추가 필드 허용"
    ]
  }
}
