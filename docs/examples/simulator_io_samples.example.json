          },
          {
            "joint": "shoulder_r",
            "label": "오른쪽 어깨",
            "distance": 0.0173,
            "angle_corrections": {},
            "correction_text": "오른쪽 어깨: 양호"
          },
          {
            "joint": "shoulder_l",
